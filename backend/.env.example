# SHILP AI Configuration Template
# Copy this file to .env and fill in credentials if available

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./shilp.db

# AI & LLM Providers (Optional for testing, automatic zero-hallucination fallback enabled)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Amazon Karigar Selling Partner API (SP-API)
AMAZON_SP_API_ENABLED=False
AMAZON_CLIENT_ID=mock_client_id
AMAZON_CLIENT_SECRET=mock_client_secret
AMAZON_REFRESH_TOKEN=mock_refresh_token
AMAZON_SELLER_ID=MOCK_SELLER_RV_001
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV

# ONDC Network Configuration
ONDC_BAP_URI=https://staging.gateway.ondc.org
ONDC_DOMAIN=nic2004:52110
